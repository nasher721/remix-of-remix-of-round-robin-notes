# =============================================================================
# Round Robin Notes — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.

# ---------------------------------------------------------------------------
# Supabase (required)
# ---------------------------------------------------------------------------
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# ---------------------------------------------------------------------------
# CI / GitHub Actions (repository Secrets — not local .env)
# ---------------------------------------------------------------------------
# Set repository variable VITE_SUPABASE_URL to the public project URL. Set
# SUPABASE_ANON_KEY to the SAME public browser key as
# VITE_SUPABASE_PUBLISHABLE_KEY; CI uses it for production builds and the
# post-deploy healthcheck. Configure VERCEL_DEPLOY_HOOK_URL for the controlled
# production frontend release.
# See docs/deployment.md

# ---------------------------------------------------------------------------
# Playwright E2E (local only — prefer .env.local; never commit real passwords)
# ---------------------------------------------------------------------------
# Required for login → Round runner / dashboard / roster / print-export specs.
# Auth page smoke runs without these. Round walk path needs ≥3 patients for the user.
# Full-suite setup/teardown resets the three owner-scoped synthetic patients
# named E2E Alpha, E2E Bravo, and E2E Charlie; never use a clinical account.
# E2E_TEST_EMAIL=e2e-round-runner@roundrobin.local
# E2E_TEST_PASSWORD=

# ---------------------------------------------------------------------------
# UI feature flags
# ---------------------------------------------------------------------------
# Focus-first Today’s Round runner on desktop (default on when unset).
# Set to 0 to keep classic DesktopDashboard chrome.
# VITE_ROUND_RUNNER=1

# ---------------------------------------------------------------------------
# Central observability sink (at least one required in production)
# ---------------------------------------------------------------------------
# Option A: hosted Sentry browser SDK. The PHI-safe operational bridge sends
# bounded error, marketing-funnel, and metric classifications without patient,
# account, form, URL, or request payload content.
# VITE_SENTRY_DSN=https://publickey@o123.ingest.sentry.io/456
#
# Option B: the bundled PHI-safe Supabase telemetry function. Production
# accepts only same-origin or Supabase-hosted HTTPS endpoints allowed by CSP.
# The deploy workflow smoke-tests this endpoint before releasing the frontend.
# VITE_TELEMETRY_INGEST_URL=https://project.supabase.co/functions/v1/telemetry
#
# Release string: auto at build = package.json version (+ VERCEL_GIT_COMMIT_SHA on Vercel).
# Override for Sentry release tracking / source maps:
# VITE_APP_VERSION=1.2.3+prod

# ---------------------------------------------------------------------------
# LLM Provider API Keys
# ---------------------------------------------------------------------------
# These keys belong only in Supabase Edge Function secrets. Never prefix a
# provider credential with VITE_: every VITE_* value is public in the browser
# bundle. Configure secrets with `supabase secrets set` in deployed projects.
#
# Clinical AI is key-based: it is available whenever at least one provider
# credential below is configured, resolving Gemini-first with automatic
# failover across configured providers. Client model selections are still
# validated against a server-side allowlist. Set CLINICAL_AI_DISABLED=true as
# an operational kill switch to turn clinical AI off without removing keys.
CLINICAL_AI_DISABLED=false
#
# OpenAI (GPT-4o, GPT-4o-mini, Whisper)
OPENAI_API_KEY=

# Google Gemini (Gemini 2.5 Pro, Flash)
GEMINI_API_KEY=

# Groq-hosted Llama (UI aliases: Grok 2 / Grok 2 Mini)
GROQ_API_KEY=

# Optional dedicated HMAC secret for distributed rate-limit identifiers.
# If omitted, Supabase Edge Functions use their injected service-role key.
# RATE_LIMIT_HASH_SECRET=

# ---------------------------------------------------------------------------
# Marketing / landing page
# ---------------------------------------------------------------------------
# Required before market launch; optional for an explicitly prelaunch deployment.
# When absent, contact CTAs are hidden. Configured values remain strictly validated.
# VITE_CONTACT_EMAIL=rounds-team@hospital.org
# Required before market launch; optional for an explicitly prelaunch deployment.
# When absent, /privacy renders honest setup guidance rather than an approved notice.
# VITE_PRIVACY_NOTICE_URL=https://privacy.hospital.org/rolling-rounds
# Required canonical production origin used for absolute metadata, sitemap,
# robots, release verification, and monitoring. Supply only the HTTPS origin.
VITE_PUBLIC_APP_URL=https://rounds.hospital.org
# Required production inactivity timeout used by both the browser guard and
# hosted Supabase Auth. Allowed range: 300-3600 seconds. The deployment owner
# must select and document the value for its device and identity policy.
VITE_SESSION_IDLE_TIMEOUT_SECONDS=1800

# OAuth providers are hidden by default. Enable only providers configured in
# Supabase Auth and approved for this deployment. Supported: google,apple
# VITE_APPROVED_OAUTH_PROVIDERS=google
